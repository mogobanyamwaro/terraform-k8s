# Copy to terraform.tfvars and set your values.
# Do not commit terraform.tfvars if it contains sensitive data.

aws_region   = "us-east-1"
project_name = "myapp"

# DynamoDB
dynamodb_table_name  = "items"
dynamodb_billing_mode = "PAY_PER_REQUEST"  # or PROVISIONED
dynamodb_hash_key    = "id"

# Lambda
lambda_runtime  = "nodejs20.x"
lambda_handler  = "index.handler"

# API Gateway
api_gateway_stage_name = "default"

# Amplify (optional: leave empty to create app without Git, then connect in Console)
amplify_repository = ""           # e.g. "https://github.com/user/repo"
amplify_branch     = "main"
amplify_enable_auto_branch_creation = false
